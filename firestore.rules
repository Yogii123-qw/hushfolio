rules_version = '2';

// Hushfolio Firestore security rules.
// Every document lives under the owning user's UID. No cross-user reads.
// Field types and length limits are enforced here as well as in the app,
// so a tampered client cannot write oversized or mistyped documents.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Encrypted papers (19 Nov 2026): content lives in one AES-GCM blob.
    // New writes are encrypted-only; legacy plaintext documents still
    // read (and are migrated on first read), but no new plaintext may be
    // written, and an encrypted document must not carry legacy plaintext
    // fields beside the blob. The blob cap (100,000 chars) covers a
    // 20,000-char paper plus JSON overhead after base64.
    function validEncryptedPaper(data) {
      return data.keys().hasAll(['encryptedBlob'])
        && data.encryptedBlob is string && data.encryptedBlob.size() >= 10
        && data.encryptedBlob.size() <= 100000
        && (!('photo' in data) || data.photo == null || data.photo is map)
        && !('title' in data) && !('body' in data) && !('tags' in data)
        && !('summary' in data) && !('sensitivity' in data) && !('mood' in data);
    }

    // The user's own document holds the encryption salt + check value
    // (both public, non-secret data; the passphrase is never stored).
    function validUserDoc(data) {
      return (!('encryptionSalt' in data) || data.encryptionSalt is string)
        && (!('encryptionCheck' in data) || data.encryptionCheck is string);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUserDoc(request.resource.data);
    }

    match /users/{uid}/papers/{paperId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validEncryptedPaper(request.resource.data);
      allow update: if isOwner(uid) && validEncryptedPaper(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/ledger/{runId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(
             ['action', 'requestedMode', 'inferenceSource', 'durationMs', 'ok'])
        && request.resource.data.action is string
        && request.resource.data.requestedMode is string
        && request.resource.data.inferenceSource is string
        && request.resource.data.durationMs is number
        && request.resource.data.ok is bool;
      // Ledger entries are append-only audit records: never updated or deleted.
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
