# Hushfolio environment configuration.
# Copy this file to `.env` and fill in values from YOUR OWN Firebase project
# (Firebase console > Project settings > Your apps > Web app).
# Never commit a filled-in `.env` file. The Firebase web config values below
# are identifiers for your project, not secrets — but the rules of the
# #BuildHybridAI contest forbid production keys in the repo, so they live
# only in the local `.env` file and in your hosting provider's env settings.

# Required — Firebase web app configuration.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Optional — only if Google Analytics is enabled for the project.
VITE_FIREBASE_MEASUREMENT_ID=

# Required for cloud inference when App Check enforcement is on.
# reCAPTCHA v3 site key from Firebase console > App Check.
VITE_APPCHECK_SITE_KEY=your-recaptcha-v3-site-key
# Local development only: use the App Check debug provider instead of
# reCAPTCHA. Set to "true" on localhost, register the debug token printed
# in the browser console in Firebase console > App Check > Manage debug
# tokens. Never enable this in a production build.
VITE_APPCHECK_DEBUG=false
